# URL e anon key: pubbliche, usate solo per il login (Supabase Auth) lato browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Service role key: SEGRETA. Bypassa RLS, usata SOLO nei Server Component/Action.
# Su Vercel: Project Settings -> Environment Variables, NON esporre come NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# URL pubblico di produzione del pannello (senza slash finale). Usato per
# costruire il link nelle email di invito - deve corrispondere esattamente
# a una voce in Supabase Auth -> Authentication -> URL Configuration ->
# Redirect URLs, altrimenti Supabase lo ignora e usa il Site URL di default.
NEXT_PUBLIC_SITE_URL=https://app-tca-alpha.vercel.app

# Notifiche push (Web Push standard, non serve Firebase). Chiave pubblica
# esposta al browser, privata SEGRETA (mai NEXT_PUBLIC_*): generare la
# coppia una sola volta con `npx web-push generate-vapid-keys` e non
# rigenerarla piu', altrimenti le sottoscrizioni push esistenti si rompono.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BB...chiave_pubblica...
VAPID_PRIVATE_KEY=chiave_privata...
# Contatto mostrato ai servizi push (Google/Apple/Mozilla) in caso di abuso:
# un mailto: o l'URL del sito, va bene uno qualsiasi dei due.
VAPID_SUBJECT=mailto:info@tcambrosiano.com

# PerfectGym: stesse credenziali già usate dal workflow n8n "2. CONTATTACI:
# FORM COMPILATO" (nodo ADD LEAD) per i lead del sito. SEGRETE, usate SOLO
# lato server (lib/perfectgym.ts), mai NEXT_PUBLIC_*.
PERFECTGYM_API_URL=https://tcambrosiano.perfectgym.com
PERFECTGYM_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERFECTGYM_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sito pubblico da cui leggere il manifest degli eventi prenotabili
# (/eventi-prenotabili.json, pubblicato dalla build Astro). E' la fonte di
# verita' per capienza e quote: senza, /api/eventi/* risponde "non
# prenotabile". Senza slash finale.
SITO_TCA_URL=https://tcambrosiano.com

# Webhook n8n che verifica se un'email e' di un socio con contratto attivo:
# lo stesso gia' usato dal form contatti del sito. Ha un default nel codice
# (lib/eventi.ts), la variabile serve solo per puntarne un altro.
N8N_WEBHOOK_VERIFICA_ISCRITTO=https://automazione.n8ndevelop.it/webhook/tca-verifica-iscritto

# Webhook n8n che manda le email del flusso eventi (prenotazione ricevuta e
# pagamento confermato). Se vuoto, le email non partono e la prenotazione
# resta comunque valida: vedi notificaEmailEvento in lib/eventi.ts.
N8N_WEBHOOK_EVENTO_EMAIL=https://automazione.n8ndevelop.it/webhook/tca-evento-email

# Segreto dei Vercel Cron (Project Settings -> Environment Variables):
# protegge /api/cron/eventi-scadute, che altrimenti sarebbe pubblica e
# permetterebbe a chiunque di far scadere prenotazioni valide.
CRON_SECRET=stringa-casuale-lunga
